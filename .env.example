NODE_ENV=development
PORT=3000
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
POSTGRES_PORT=55432
POSTGRES_DATA_DIR=./data/postgres
POSTGRES_ADMIN_PASSWORD=local-only-admin-password
POSTGRES_RUNTIME_PASSWORD=local-only-runtime-password
POSTGRES_MIGRATION_PASSWORD=local-only-migration-password
POSTGRES_BACKUP_PASSWORD=local-only-backup-password
DATABASE_URL=postgresql://overtime_app:local-only-runtime-password@127.0.0.1:55432/overtime
DATABASE_MIGRATION_URL=postgresql://overtime_migrator:local-only-migration-password@127.0.0.1:55432/overtime
SQLITE_SOURCE_PATH=./data/overtime.sqlite
GOOGLE_CLIENT_ID=local-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=local-google-client-id.apps.googleusercontent.com
GOOGLE_HOSTED_DOMAIN=company.com
ADMIN_EMAILS=contact@aimskr.com
SESSION_COOKIE_NAME=overtime_session
SESSION_TTL_DAYS=7
SESSION_HASH_SECRET=replace-with-at-least-32-random-characters
